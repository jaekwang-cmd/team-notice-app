{
  "name": "team-notice-app",
  "version": "0.39.3",
  "description": "일정과 기록, 영업 정산을 담는 개인 다이어리",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always",
    "test": "node --test tests/calendar-refresh.test.js tests/calendar-responsive.test.js tests/journal-entry.test.js tests/journal-render.test.js tests/journal-worlds.test.js tests/night-theme-picker.test.js tests/night-theme.test.js tests/ui-refinements.test.js",
    "test:ui": "node tests/storybook-ui.cjs",
    "test:ui:nature": "node tests/storybook-nature-ui.cjs",
    "test:ui:layout": "node tests/storybook-layout-ui.cjs"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/tasks": "^13.0.0",
    "date-holidays": "^3.23.12",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "firebase": "^10.14.1",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.teamnotice.app",
    "productName": "여백",
    "artifactName": "team-notice-app-setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/renderer/premium*.*",
      "!src/renderer/premium-fonts/**/*",
      "assets/**/*",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "jaekwang-cmd",
      "repo": "team-notice-app",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
