{
  "name": "team-notice-app",
  "version": "0.37.0",
  "description": "개인 캘린더 + 팀 실시간 공지 데스크톱 앱",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@googleapis/calendar": "^16.0.0",
    "@googleapis/tasks": "^13.0.0",
    "date-holidays": "^3.23.12",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "firebase": "^10.14.1",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.teamnotice.app",
    "productName": "스케줄 캘린더",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "jaekwang-cmd",
      "repo": "team-notice-app",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
